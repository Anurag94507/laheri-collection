# ---- Core ----
PORT=5178
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=shop12345

# ---- Database (optional) ----
# Leave empty to use the built-in JSON data store at server/data/db.json.
# Set a MongoDB Atlas connection string to use MongoDB instead.
MONGODB_URI=
MONGODB_DB=raja_menswear

# ---- AI chatbot (optional; falls back to the built-in shop assistant) ----
ANTHROPIC_API_KEY=
CHATBOT_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Email (optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Raja Menswear <no-reply@example.com>

# ---- WhatsApp / SMS (optional; links are generated when unset) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# ---- Payments (optional; checkout runs in demo mode when unset) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
